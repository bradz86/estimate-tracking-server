# Server Configuration
PORT=3000
API_KEY=your-api-key-here
ALLOWED_ORIGINS=https://yourdomain.com

# Where tracking-data.json lives. MUST point at a persistent disk in production —
# the default sits in the deploy directory, which is wiped on every restart.
DB_PATH=/var/data/tracking-data.json

# Apple Push Notifications (APNs)
# Get these from Apple Developer Portal
APNS_KEY_ID=ABC123XYZ0
APNS_TEAM_ID=TEAMID1234
APP_BUNDLE_ID=com.estimatepro.app
# Option 1: Place your .p8 key file as 'apns-key.p8' in the server directory
# Option 2: Base64 encode the key (for platforms like Render free tier):
#   Run: base64 -i your-key.p8 | tr -d '\n'
#   Then set APNS_KEY_BASE64 to the output
APNS_KEY_BASE64=

# Email Notifications (SMTP)
# You can use Gmail, SendGrid, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=EstimatePro <notifications@yourdomain.com>

# Sign in with Apple — account deletion / token revocation
# Required by App Store Review Guideline 5.1.1(v). Uses a Sign in with Apple key,
# which is a DIFFERENT key from the APNs one above (Certificates, Identifiers &
# Profiles > Keys > enable "Sign in with Apple").
#   base64 -i AuthKey_XXXXXXXX.p8 | tr -d '\n'
# Leave unset and /api/apple/* return 501; deletion then erases local and server
# data but does not revoke the Apple grant.
APPLE_CLIENT_ID=com.estimatepro.app
APPLE_TEAM_ID=TEAMID1234
APPLE_KEY_ID=ABC123XYZ0
APPLE_KEY_BASE64=

# QuickBooks OAuth (server-side token exchange)
# Get these from developer.intuit.com
QB_CLIENT_ID=your-quickbooks-client-id
QB_CLIENT_SECRET=your-quickbooks-client-secret

# Production
NODE_ENV=development
